# Campus Lost & Found — environment variables
# Bu dosya GitHub'a gönderilir. Gerçek anahtarlar .env.local içinde durur.
#
# Kurulum:
#   1. cp .env.example .env.local
#   2. Supabase Dashboard > Project Settings > API sayfasından değerleri kopyala
#   3. npm run dev

# Supabase Dashboard > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Dashboard > Project Settings > API > Project API keys > anon / public
# Bu anahtar tarayıcıya gider; güvenlik RLS policy'leri ile sağlanır.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Magic link e-postasındaki linkin geri döneceği adres.
# Local geliştirmede http://localhost:3000, Vercel'de canlı domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
